  "event": [
    {
      "listen": "prerequest",
      "script": {
        "id": "fd27f9ee-6f02-472e-a5a2-7c7794f4ce0b",
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "// Base URL + API version\r",
          "pm.environment.set(\r",
          "    \"api_base\",\r",
          "    pm.environment.get(\"base_url\") + \"/api/\" + pm.environment.get(\"api_version\")\r",
          ");\r",
          "\r",
          "// Attach token if available\r",
          "const token = pm.environment.get(\"token\");\r",
          "\r",
          "if (token) {\r",
          "    pm.request.headers.upsert({\r",
          "        key: \"Authorization\",\r",
          "        value: \"Bearer \" + token\r",
          "    });\r",
          "}\r",
          ""
        ]
      }
    },

      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "ab423152-75b6-476c-b82d-f11cec71b3c0",
                "exec": [
                  "// Tests for \"Login\" request\r",
                  "const responseJson = (() => {\r",
                  "    try {\r",
                  "        return pm.response.json();\r",
                  "    } catch (e) {\r",
                  "        return null;\r",
                  "    }\r",
                  "})();\r",
                  "\r",
                  "// 1) Status code is 200 or 201 (accept common success codes)\r",
                  "pm.test(\"Status is 200 or 201\", () => {\r",
                  "    pm.expect(pm.response.code === 200 || pm.response.code === 201).to.be.true;\r",
                  "});\r",
                  "\r",
                  "// 2) Response body is valid JSON\r",
                  "pm.test(\"Response is JSON\", () => {\r",
                  "    pm.expect(responseJson, \"Response body is valid JSON\").to.be.an(\"object\");\r",
                  "});\r",
                  "\r",
                  "// 3) Token exists and looks like a JWT (three dot-separated parts)\r",
                  "pm.test(\"Response contains a token (looks like JWT)\", () => {\r",
                  "    pm.expect(responseJson, \"response JSON must exist\").to.be.an(\"object\");\r",
                  "    pm.expect(responseJson).to.have.property(\"token\");\r",
                  "    pm.expect(responseJson.token, \"token must be a non-empty string\").to.be.a(\"string\").that.is.not.empty;\r",
                  "    // basic JWT-like format check\r",
                  "    const parts = responseJson.token.split(\".\");\r",
                  "    pm.expect(parts.length === 3, \"token should have three parts (JWT)\").to.be.true;\r",
                  "});\r",
                  "\r",
                  "// 4) Optional: user object exists with id and email (if your API returns user info)\r",
                  "pm.test(\"Response contains user.id and user.email when user object present\", () => {\r",
                  "    if (responseJson && responseJson.user) {\r",
                  "        pm.expect(responseJson.user).to.be.an(\"object\");\r",
                  "        pm.expect(responseJson.user).to.have.property(\"id\");\r",
                  "        pm.expect(responseJson.user.id).to.satisfy(val => typeof val === \"number\" || typeof val === \"string\");\r",
                  "        pm.expect(responseJson.user).to.have.property(\"email\");\r",
                  "        pm.expect(responseJson.user.email).to.be.a(\"string\").that.includes(\"@\");\r",
                  "    } else {\r",
                  "        pm.expect(true).to.be.true; // pass when no user object is returned (keeps test suite flexible)\r",
                  "    }\r",
                  "});\r",
                  "\r",
                  "// 5) Response time under 2 seconds\r",
                  "pm.test(\"Response time is less than 2000 ms\", () => {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  "\r",
                  "// 6) Content-Type header is application/json\r",
                  "pm.test(\"Content-Type is application/json\", () => {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
                  "});\r",
                  "\r",
                  "// 7) Helpful failure tests: if unauthorized, assert proper structure for error\r",
                  "pm.test(\"If unauthorized, response includes message\", () => {\r",
                  "    if (pm.response.code === 401 || pm.response.code === 403) {\r",
                  "        pm.expect(responseJson).to.be.an(\"object\");\r",
                  "        pm.expect(responseJson).to.have.property(\"message\");\r",
                  "        pm.expect(responseJson.message).to.be.a(\"string\").that.is.not.empty;\r",
                  "    } else {\r",
                  "        pm.expect(true).to.be.true;\r",
                  "    }\r",
                  "});\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },

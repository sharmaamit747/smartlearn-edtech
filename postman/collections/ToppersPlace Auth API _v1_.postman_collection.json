    {
      "name": "Auth / Verify OTP",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "37acc4b4-3f26-412d-a122-f456f383d6cc",
            "exec": [
              "pm.test(\"OTP verified\", () => {\r",
              "  pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const json = pm.response.json();\r",
              "\r",
              "pm.test(\"Token received\", () => {\r",
              "  pm.expect(json.token).to.exist;\r",
              "});\r",
              "\r",
              "// Save token\r",
              "pm.collectionVariables.set(\"token\", json.token);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },

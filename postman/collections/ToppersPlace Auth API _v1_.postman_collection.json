  "item": [
    {
      "name": "Auth / Register (OTP)",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "57910fe0-7166-4cb7-be4c-7743544acfff",
            "exec": [
              "pm.test(\"Register success\", () => {\r",
              "  pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"OTP required\", () => {\r",
              "  const json = pm.response.json();\r",
              "  pm.expect(json.status).to.eql(\"success\");\r",
              "  pm.expect(json.next).to.eql(\"verify-otp\");\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
